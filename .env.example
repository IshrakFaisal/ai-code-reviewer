# With no configuration the application starts in clearly labeled demo mode.
DEMO_MODE=true
GITHUB_TOKEN=
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Choose an NVIDIA model available in your Token Factory account /v1/models.
NEBIUS_MODEL=
# Validate exact catalog availability and require the NVIDIA namespace by default.
NEBIUS_REQUIRE_NVIDIA=true
MAX_INVESTIGATIONS=5
# disabled | docker | native | nebius. Docker supports Windows through Docker Desktop.
SANDBOX_PROVIDER=disabled
# Reproduce & repair requires Docker or Nebius; native is excluded from this workflow.
# Paired runs use the same provider gate/allowlist. Live repair uses NEBIUS_API_KEY/MODEL.
ENABLE_LOCAL_SANDBOX=false
# Explicit trusted public repositories, comma-separated.
LOCAL_SANDBOX_REPOSITORIES=
# Pre-pull this image; the provider resolves and pins its local image ID.
SANDBOX_DOCKER_IMAGE=node:22-bookworm
# Remote execution has its own enablement, credentials, and public repository allowlist.
ENABLE_NEBIUS_SANDBOX=false
NEBIUS_SANDBOX_REPOSITORIES=
NEBIUS_SANDBOX_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes
# Nebius IAM token and project ID; inference keys alone do not enable execution.
NEBIUS_SANDBOX_TOKEN=
NEBIUS_SANDBOX_PROJECT_ID=
# Immutable UUID of an already imported, trusted Node 22+ image with git and npm/Corepack.
NEBIUS_SANDBOX_IMAGE=
# Production execution additionally requires Docker or Nebius and operator opt-in.
ENABLE_PRODUCTION_SANDBOX=false
# Leave blank for the loopback-only demo. Public hosting requires HTTPS and auth.
APP_ORIGIN=
APP_AUTH_USERNAME=
# At least 24 characters. Never commit the real value or use NEXT_PUBLIC_*.
APP_AUTH_PASSWORD=
# Optional JSON overrides, e.g. {"authentication":35,"payments":30}
RISK_WEIGHTS_JSON=
# Reserved; this MVP uses local JSON reports and needs no database.
DATABASE_URL=
